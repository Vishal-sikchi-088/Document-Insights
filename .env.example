# Copy this file to .env and adjust as needed.
# All values below are the defaults the app falls back to if unset.

# --- App ---
APP_NAME=document-insights-api
ENVIRONMENT=development       # development | production
LOG_LEVEL=INFO

# --- MongoDB ---
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB_NAME=document_insights

# --- Redis ---
REDIS_URL=redis://localhost:6379/0
REDIS_QUEUE_KEY=document_insights:queue:documents

# --- Rate limiting ---
# Max documents a single user may have in queued/processing state at once.
RATE_LIMIT_MAX_ACTIVE_JOBS=3

# --- Content cache ---
# How long a completed summary stays cached against its content hash.
CACHE_TTL_SECONDS=86400

# --- Worker ---
WORKER_MIN_PROCESSING_SECONDS=10
WORKER_MAX_PROCESSING_SECONDS=30
WORKER_FAILURE_RATE=0.1        # probability a job fails, as a fraction (0.1 = 10%)
WORKER_MAX_RETRIES=2           # retries after the first attempt, before terminal "failed"
WORKER_RETRY_BACKOFF_SECONDS=5 # base backoff; doubles per retry attempt

# --- Pagination ---
PAGINATION_DEFAULT_PAGE_SIZE=20
PAGINATION_MAX_PAGE_SIZE=100
